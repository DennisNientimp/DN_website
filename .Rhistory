make_heatmap <- function(file_path, experiment_name, output_dir) {
library(tidyverse)
library(ggplot2)
# Create output directory if it doesn't exist
if (!dir.exists(output_dir)) {
dir.create(output_dir, recursive = TRUE)
}
# Load data
df_raw <- read_csv(file_path, skip = 6)
# Filter final step
df_final <- df_raw %>%
filter(`[step]` == 200)
# Compute mean + CI
df_heat <- df_final %>%
group_by(`eps-value`, `acceptability-threshold`) %>%
summarise(
mean_prop = mean(`(count turtles with [adopted?]) / count turtles`),
sd_prop   = sd(`(count turtles with [adopted?]) / count turtles`),
n         = n(),
se        = sd_prop / sqrt(n),
ci_lower  = mean_prop - qt(0.975, df = n - 1) * se,
ci_upper  = mean_prop + qt(0.975, df = n - 1) * se,
.groups = "drop"
) %>%
mutate(
label = paste0(
round(mean_prop, 2), "\n(",
round(ci_lower, 2), "–", round(ci_upper, 2), ")"
)
)
# Build heatmap
p_heat <- ggplot(df_heat, aes(
x = `acceptability-threshold`,
y = `eps-value`,
fill = mean_prop
)) +
geom_tile() +
geom_text(aes(label = label), color = "black", size = 3.4, lineheight = 0.9) +
scale_fill_viridis_c(option = "plasma", limits = c(0, 1)) +
scale_x_continuous(breaks = sort(unique(df_heat$`acceptability-threshold`))) +
scale_y_continuous(breaks = sort(unique(df_heat$`eps-value`))) +
labs(
title = paste0("Mean Adoption Rate with 95% CI (step 200)\n", experiment_name),
x = "Tie‑Acceptability Threshold",
y = "Epsilon (Confidence Bound)",
fill = "Mean\nAdoption"
) +
coord_fixed() +
theme_minimal(base_size = 14) +
theme(
axis.text.x = element_text(angle = 90, vjust = 0.5),
panel.grid = element_blank()
)
# Build full output path
out_path <- file.path(output_dir, paste0("heatmap_", experiment_name, ".pdf"))
# Save PDF
ggsave(out_path, p_heat, width = 10, height = 10, dpi = 300)
return(p_heat)
}
