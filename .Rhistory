clean_sim_output <- function(df) {
df %>%
filter(`[step]` == 200) %>%
rename(
adoption_rate = `(count turtles with [adopted?]) / count turtles`,
eps = `eps-value`,
threshold = `acceptability-threshold`,
network = `network-type`
) %>%
select(
run = `[run number]`,
network,
eps,
threshold,
adoption_rate
)
}
